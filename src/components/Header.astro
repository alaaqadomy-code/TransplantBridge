---
import { SITE, NAV, WHATSAPP } from "../lib/site";
const path = Astro.url.pathname.replace(/\.html$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="sticky top-0 z-40 border-b border-shifa-100/70 bg-paper/85 backdrop-blur-md">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-4">
    <!-- الشعار -->
    <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label={`${SITE.name} — الصفحة الرئيسية`}>
      <span class="relative grid h-10 w-10 place-items-center rounded-2xl bg-gradient-to-br from-shifa-500 to-shifa-700 shadow-glow transition-transform duration-500 group-hover:scale-105">
        <!-- جسر: قوس يصل ضفتين -->
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
          <path d="M3 16c0-5 4-8 9-8s9 3 9 8" stroke="white" stroke-width="2" stroke-linecap="round" />
          <path d="M3 16h18M8 16v-4M16 16v-4M12 16v-6" stroke="white" stroke-width="1.6" stroke-linecap="round" opacity=".85" />
        </svg>
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-[1.0625rem] font-semibold text-ink-900">{SITE.name}</span>
        <span class="mt-0.5 text-[0.6875rem] text-ink-400">{SITE.tagline}</span>
      </span>
    </a>

    <!-- القائمة — كمبيوتر -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="القائمة الرئيسية">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "rounded-full px-3.5 py-2 font-display text-[0.9375rem] transition-colors duration-200",
            isActive(item.href)
              ? "bg-shifa-50 text-shifa-800"
              : "text-ink-600 hover:bg-shifa-50/60 hover:text-shifa-800",
          ]}
        >{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={WHATSAPP.link(WHATSAPP.defaultMessage)}
        target="_blank"
        rel="noopener"
        class="btn-primary !px-5 !py-2.5 !text-[0.9375rem]"
        data-wa="header"
      >
        <svg viewBox="0 0 24 24" class="h-[1.125rem] w-[1.125rem]" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.02a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.22 8.22 0 1 1 6.98 3.87Zm4.5-6.15c-.25-.12-1.46-.72-1.68-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.04s.87 2.37.99 2.53c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.46-.6 1.66-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.28Z"/>
        </svg>
        <span class="hidden sm:inline">تواصل معنا</span>
        <span class="sm:hidden">واتساب</span>
      </a>

      <!-- زر القائمة — هاتف -->
      <button
        type="button"
        id="navToggle"
        aria-expanded="false"
        aria-controls="navMobile"
        class="grid h-11 w-11 place-items-center rounded-2xl border border-shifa-200 bg-white text-ink-700 transition-colors hover:bg-shifa-50 lg:hidden"
      >
        <span class="sr-only">فتح القائمة</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- القائمة — هاتف -->
  <nav
    id="navMobile"
    hidden
    class="border-t border-shifa-100 bg-white lg:hidden"
    aria-label="القائمة الرئيسية للهاتف"
  >
    <div class="wrap flex flex-col gap-1 py-4">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "rounded-2xl px-4 py-3 font-display text-base transition-colors",
            isActive(item.href) ? "bg-shifa-50 text-shifa-800" : "text-ink-700 hover:bg-shifa-50/70",
          ]}
        >{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("navToggle");
    const menu = document.getElementById("navMobile");
    if (!btn || !menu) return;
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      menu.hidden = open;
    });
  })();
</script>
