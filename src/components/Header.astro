---
import { SITE, NAV, WHATSAPP } from "../lib/site";

const path = Astro.url.pathname.replace(/\.html$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header
  id="siteHeader"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-all duration-500"
>
  <div class="wrap flex h-[4.75rem] items-center justify-between gap-4">
    <!-- الشعار -->
    <a href="/" class="group flex shrink-0 items-center gap-3" aria-label={`${SITE.name} — الصفحة الرئيسية`}>
      <span class="relative grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-br from-shifa-400 to-shifa-700 shadow-glow transition-transform duration-500 group-hover:scale-105">
        <svg viewBox="0 0 24 24" class="h-[1.375rem] w-[1.375rem]" fill="none" aria-hidden="true">
          <path d="M3 16c0-5 4-8 9-8s9 3 9 8" stroke="white" stroke-width="2.1" stroke-linecap="round"/>
          <path d="M3 16h18M8 16v-4M16 16v-4M12 16v-6" stroke="white" stroke-width="1.6" stroke-linecap="round" opacity=".85"/>
        </svg>
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-[1.0625rem] font-bold tracking-tightest text-white">{SITE.name}</span>
        <span class="mt-1 text-[0.6875rem] text-shifa-200/70">{SITE.tagline}</span>
      </span>
    </a>

    <!-- القائمة — كمبيوتر -->
    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="القائمة الرئيسية">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "rounded-full px-4 py-2.5 font-display text-[0.9375rem] font-medium transition-all duration-200",
            isActive(item.href)
              ? "bg-white/[.12] text-white"
              : "text-white/75 hover:bg-white/[.08] hover:text-white",
          ]}
        >{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={WHATSAPP.link(WHATSAPP.defaultMessage)}
        target="_blank"
        rel="noopener"
        class="btn-primary !px-5 !py-2.5 !text-[0.9375rem]"
        data-wa="header"
      >
        <svg viewBox="0 0 24 24" class="h-[1.125rem] w-[1.125rem]" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.02a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.22 8.22 0 1 1 6.98 3.87Z"/>
        </svg>
        <span class="hidden sm:inline">تواصل معنا</span>
        <span class="sm:hidden">واتساب</span>
      </a>

      <button
        type="button"
        id="navToggle"
        aria-expanded="false"
        aria-controls="navMobile"
        class="grid h-11 w-11 place-items-center rounded-2xl border border-white/15 bg-white/[.06] text-white transition-colors hover:bg-white/[.12] lg:hidden"
      >
        <span class="sr-only">فتح القائمة</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- القائمة — هاتف -->
  <nav id="navMobile" hidden class="border-t border-white/10 bg-deep-800/95 backdrop-blur-md lg:hidden" aria-label="القائمة الرئيسية للهاتف">
    <div class="wrap flex flex-col gap-1 py-4">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "rounded-2xl px-4 py-3 font-display text-base font-medium transition-colors",
            isActive(item.href) ? "bg-white/[.12] text-white" : "text-white/80 hover:bg-white/[.07]",
          ]}
        >{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  /* عند التمرير: تمويه وحدّ خفيف، بلا تغيير لون النص (الثيم داكن في كل الحالات) */
  #siteHeader.is-stuck {
    border-bottom-color: rgba(255, 255, 255, 0.08);
    background: rgba(6, 18, 29, 0.75);
    backdrop-filter: blur(14px);
  }
</style>

<script is:inline>
  (() => {
    const header = document.getElementById("siteHeader");
    const btn = document.getElementById("navToggle");
    const menu = document.getElementById("navMobile");

    if (btn && menu) {
      btn.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!open));
        menu.hidden = open;
      });
    }

    if (header) {
      const onScroll = () => header.classList.toggle("is-stuck", window.scrollY > 24);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }
  })();
</script>
