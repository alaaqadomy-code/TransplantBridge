---
import { WHATSAPP } from "../lib/site";
---

<!-- زر عائم ثابت — في متناول الإبهام على الهاتف -->
<a
  href={WHATSAPP.link(WHATSAPP.defaultMessage)}
  target="_blank"
  rel="noopener"
  data-wa="floating"
  aria-label="تواصل معنا عبر واتساب"
  class="group fixed bottom-5 left-5 z-50 flex items-center gap-2.5 rounded-full bg-shifa-600 py-3.5 pl-5 pr-4 text-white shadow-lift transition-all duration-300 hover:bg-shifa-700 hover:-translate-y-0.5 no-print sm:bottom-7 sm:left-7"
>
  <span class="relative grid h-6 w-6 shrink-0 place-items-center">
    <!-- هالة النبض الخفيف -->
    <span class="absolute inset-0 rounded-full bg-white/45 animate-halo" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" class="relative h-6 w-6" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.02a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.22 8.22 0 1 1 6.98 3.87Zm4.5-6.15c-.25-.12-1.46-.72-1.68-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.04s.87 2.37.99 2.53c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.46-.6 1.66-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.28Z"/>
    </svg>
  </span>
  <span class="font-display text-[0.9375rem] font-medium">تواصل معنا</span>
</a>
