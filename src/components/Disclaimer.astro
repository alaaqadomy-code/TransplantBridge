---
import { DISCLAIMER } from "../lib/site";
---

<aside class="flex gap-3.5 rounded-4xl border border-amal/25 bg-amal/[.07] p-5 text-[0.875rem] leading-relaxed text-ink-200" role="note">
  <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-amal-light" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 8h.01M11 12h1v4h1" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  {/*
    الرابط إلى النص الكامل: كان إخلاء المسؤولية يظهر على 28 صفحة بلا رابط
    إلى صفحته، فكان الزائر يقرأ الموجز ولا يجد التفصيل، وكانت الصفحة
    القانونية بلا رابط واحد داخل المحتوى.
  */}
  <p>
    {DISCLAIMER}{" "}
    <a href="/medical-disclaimer" class="font-semibold text-amal-light underline decoration-amal/40 underline-offset-4 transition-colors hover:decoration-amal-light"
      >اقرأ إخلاء المسؤولية الطبية كاملاً</a
    >.
  </p>
</aside>
