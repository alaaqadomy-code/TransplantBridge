---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../lib/site";
---

<Layout
  title={`الصفحة غير موجودة — ${SITE.name}`}
  description="الصفحة المطلوبة غير موجودة. تصفّح أقسام زرع الكبد وزراعة الكلى والتبرع والتكلفة."
  path="/404"
  noindex={true}
>
  <section class="wrap py-24 text-center sm:py-32">
    <p class="font-display text-7xl font-semibold text-gradient animate-shimmer">404</p>
    <h1 class="mt-6 text-3xl font-semibold sm:text-4xl">هذه الصفحة غير موجودة</h1>
    <p class="mx-auto mt-4 max-w-md text-[1.0625rem] leading-relaxed text-ink-500">
      ربما تغيّر الرابط أو كُتب خطأً. يمكنك البدء من هنا:
    </p>

    <div class="mx-auto mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
      <a href="/liver-transplant" class="card card-lift text-right">
        <h2 class="font-display text-lg font-semibold text-ink-900">زرع الكبد</h2>
        <p class="mt-2 text-[0.9375rem] text-ink-500">ما هو، ومتى يلزم، وكيف تُجرى العملية.</p>
      </a>
      <a href="/kidney-transplant" class="card card-lift text-right">
        <h2 class="font-display text-lg font-semibold text-ink-900">زراعة الكلى</h2>
        <p class="mt-2 text-[0.9375rem] text-ink-500">الخطوات والشروط ونسب النجاح وما بعدها.</p>
      </a>
    </div>

    <a href="/" class="btn-ghost mt-8">العودة إلى الرئيسية</a>
  </section>
</Layout>
