---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, ROLE } from "../lib/site";
import { graph, organization, website, webPage, breadcrumbs } from "../lib/schema";

const title = "إخلاء المسؤولية الطبية — TransplantBridge";
const description =
  "إخلاء المسؤولية الطبية: حدود المعلومات المنشورة على الموقع، ولماذا لا ننشر أسعاراً ولا نسب نجاح، ومتى تجب مراجعة الطبيب فوراً.";
const path = "/medical-disclaimer";

const crumbs = [
  { name: "الرئيسية", path: "/" },
  { name: "إخلاء المسؤولية الطبية", path },
];

const jsonLd = graph([
  organization(),
  website(),
  webPage({ path, title, description }),
  breadcrumbs(crumbs),
]);
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <article class="wrap pt-32 pb-8 sm:pt-36">
    <div class="mx-auto max-w-[52rem]">
      <Breadcrumbs items={crumbs} />

      <header>
        <p class="chip">سياسات</p>
        <h1 class="mt-5 font-display text-[2.125rem] font-extrabold leading-[1.3] tracking-tightest text-white sm:text-[2.75rem]">
          إخلاء المسؤولية الطبية
        </h1>
        <p class="mt-6 text-[1.0625rem] leading-[1.95] text-ink-100 sm:text-lg">
          كل ما يُنشر على {SITE.name} معلومات عامة للتثقيف. ليست استشارة طبية، ولا تشخيصاً،
          ولا وصفة علاج، ولا بديلاً عن رأي طبيبك أو عن تقييم فريق الزراعة.
        </p>
      </header>

      <div class="panel mt-10">
        <div class="prose-ar">
          <h2>ما هذا الموقع وما ليس كذلك</h2>
          <p>{ROLE.weAre}</p>
          <p><strong>{ROLE.weAreNot}</strong></p>
          <p>
            ولا تُنشأ بينك وبيننا علاقة طبيب بمريض بأي حال، لا بقراءة الموقع ولا بالمراسلة
            عبر واتساب. القرار الطبي وتحديد الأهلية للمستشفى والفريق المعالج وحدهما.
          </p>

          <h2>حدود المعلومات المنشورة</h2>
          <ul>
            <li>المعلومات <strong>عامة</strong> ولا تنطبق بالضرورة على حالتك بعينها.</li>
            <li>قد تتغير الممارسات الطبية والمعايير بمرور الوقت.</li>
            <li>ما يصحّ لمريض قد لا يصحّ لآخر باختلاف العمر والأمراض المصاحبة وسبب الفشل العضوي.</li>
            <li>حيثما احتاجت معلومة مراجعة طبية أو قانونية قبل الاعتماد عليها، نقول ذلك في موضعها.</li>
          </ul>

          <h2>لماذا لا ننشر أسعاراً ولا نسب نجاح</h2>
          <p>
            لأن الأرقام المنشورة عربياً في هذا المجال متناقضة وغالباً بلا مصدر ولا سياق.
            ونشر رقم في قرار يخص حياة إنسان دون بيان ما يقيسه ومصدره وتاريخه ونطاقه ضررٌ
            لا نفع.
          </p>
          <p>
            فإذا نشرنا رقماً يوماً، سيكون <strong>منسوباً لمصدره، ومؤرَّخاً، ومبيَّناً ما
            يشمله وما يستثنيه</strong>. ولن ندمج مصدرين في نطاق جديد من عندنا.
            التفصيل في <a href="/transplant-cost">كيف تقرأ عرض السعر</a> و<a href="/kidney-transplant-success-rate">كيف تقرأ نسب النجاح</a>.
          </p>

          <h2>لا شهادات ولا تجارب مُركَّبة</h2>
          <p>
            لا ننشر قصص مرضى ولا شهادات ولا تقييمات. وإن نشرنا تجربة مريض يوماً فستكون
            <strong>بموافقة موثقة من صاحبها</strong> ومع بيان أنها تجربة فردية لا تُعمَّم.
            ولا نُركّب قصة ولا نختلق تجربة بأي حال.
          </p>

          <h2>متى تراجع الطبيب فوراً؟</h2>
          <p>لا تؤجل مراجعة الطوارئ أو طبيبك المعالج بسبب شيء قرأته هنا. وراجع فوراً عند:</p>
          <ul>
            <li>حرارة مرتفعة أو علامات عدوى بعد الزراعة.</li>
            <li>ألم أو تورّم فوق موضع العضو المزروع.</li>
            <li>انخفاض واضح في كمية البول أو تورّم الساقين أو زيادة سريعة في الوزن.</li>
            <li>اصفرار العينين أو الجلد، أو تغيّر في الوعي، أو نزف.</li>
            <li>أي عرض مقلق بعد تناول دواء جديد.</li>
          </ul>

          <h2>الأدوية</h2>
          <p>
            <strong>لا تُوقف مثبطات المناعة ولا تُعدّل جرعتها ولا تؤخر موعدها من تلقاء
            نفسك</strong> مهما شعرت بتحسّن أو انزعجت من آثارها الجانبية. أي تعديل يمرّ عبر
            فريق الزراعة وحده.
          </p>

          <h2>الشروط القانونية</h2>
          <p>
            ما نذكره عن شروط التبرع ودرجات القرابة منقول عن مصادر عامة ومصادر مستشفيات
            ومقدّمي خدمة، <strong>وليس نصاً قانونياً ولا رأياً قانونياً</strong>. وهذه
            المتطلبات تختلف بين الدول وقد تتغير. المرجع هو المستشفى والجهة القانونية
            المختصة في بلد العملية.
          </p>

          <h2>الروابط الخارجية</h2>
          <p>
            قد نحيل إلى مصادر خارجية للتوثيق. ولا نتحمل مسؤولية محتواها ولا نضمن دقتها أو
            تحديثها، ووجود رابط لا يعني إقراراً بكل ما فيه.
          </p>

          <h2>موقفنا من الاتجار بالأعضاء</h2>
          <p><strong>{ROLE.noTrafficking}</strong></p>

          <h2>تصحيح الأخطاء</h2>
          <p>
            إن وجدت معلومة تراها خاطئة أو قديمة، أخبرنا عبر واتساب. نراجعها، ونصححها إن
            ثبت الخطأ.
          </p>
        </div>
      </div>
    </div>
  </article>
</Layout>
