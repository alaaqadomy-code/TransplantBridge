---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, WHATSAPP } from "../lib/site";
import { graph, organization, website, webPage, breadcrumbs } from "../lib/schema";

const title = "سياسة الخصوصية — TransplantBridge";
const description =
  "سياسة الخصوصية: ما البيانات التي نستقبلها عبر واتساب، وكيف نستعملها، ومع من نشاركها، وكم نحتفظ بها، وكيف تطلب حذفها.";
const path = "/privacy";

const crumbs = [
  { name: "الرئيسية", path: "/" },
  { name: "سياسة الخصوصية", path },
];

const jsonLd = graph([
  organization(),
  website(),
  webPage({ path, title, description }),
  breadcrumbs(crumbs),
]);
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <article class="wrap pt-32 pb-8 sm:pt-36">
    <div class="mx-auto max-w-[52rem]">
      <Breadcrumbs items={crumbs} />

      <header>
        <p class="chip">سياسات</p>
        <h1 class="mt-5 font-display text-[2.125rem] font-extrabold leading-[1.3] tracking-tightest text-white sm:text-[2.75rem]">
          سياسة الخصوصية
        </h1>
        <p class="mt-6 text-[1.0625rem] leading-[1.95] text-ink-100 sm:text-lg">
          تقاريرك الطبية بيانات حسّاسة. هذه الصفحة تشرح بالضبط ما نستقبله، ولماذا، ومع من
          نشاركه، وكم نحتفظ به، وكيف تطلب حذفه.
        </p>
      </header>

      <div class="panel mt-10">
        <div class="prose-ar">
          <h2>الموقع نفسه لا يجمع بياناتك</h2>
          <p>
            لا يحتوي {SITE.name} على نموذج تسجيل ولا حقول إدخال ولا رفع ملفات. ولا نطلب
            منك اسماً ولا بريداً ولا رقماً على الموقع. التواصل كله يجري عبر واتساب بمبادرة
            منك أنت.
          </p>

          <h2>ما نستقبله عبر واتساب</h2>
          <p>حين تراسلنا، نستقبل ما ترسله أنت بإرادتك، وقد يشمل:</p>
          <ul>
            <li>اسم المريض وعمره وبلده ووسيلة التواصل.</li>
            <li>التشخيص والتقارير الطبية والتحاليل والصور الإشعاعية.</li>
            <li>معلومات عن المتبرع المحتمل وصلة قرابته.</li>
          </ul>
          <p>
            ولا نطلب أكثر مما يلزم لقراءة الملف. و<strong>لا نطلب أبداً</strong> بيانات
            بنكية ولا أرقام بطاقات ولا كلمات مرور — ومن يطلب ذلك منك باسمنا فليس منّا.
          </p>

          <h2>لماذا نستعملها</h2>
          <ul>
            <li>لقراءة حالتك وتحديد ما ينقص الملف.</li>
            <li>لتجهيز الملف بالشكل الذي يطلبه فريق الزراعة.</li>
            <li>لإحالته إلى المنسق الدولي في المستشفى بعد موافقتك.</li>
            <li>للمتابعة معك ومع المنسق بعد الإحالة.</li>
          </ul>
          <p>
            <strong>لا نستعملها في أي غرض تسويقي</strong>، ولا نرسل لك رسائل ترويجية، ولا
            نبيع بياناتك ولا نؤجّرها لأحد.
          </p>

          <h2>مع من نشاركها</h2>
          <p>
            مع <strong>الجهة الطبية المعنية بتقييم حالتك فقط</strong> — أي المستشفى والمنسق
            الدولي فيه — وبعد موافقتك. ولا نشارك ملفك مع أي جهة أخرى، ولا ننشره، ولا نذكر
            حالتك في أي محتوى.
          </p>
          <p>
            وانتبه إلى أن محادثة واتساب تمرّ عبر تطبيق تابع لجهة خارجية تخضع لسياستها هي،
            وهذا خارج سيطرتنا.
          </p>

          <h2>كم نحتفظ بها</h2>
          <p>
            نحتفظ بملفك طوال مدة متابعة حالتك وللمدة التي يقتضيها توثيق الإحالة. ثم
            <strong>لك أن تطلب حذف ملفك في أي وقت</strong> عبر واتساب، وننفّذ ذلك ونؤكد لك
            التنفيذ — ما لم يكن هناك التزام قانوني أو توثيقي يمنع الحذف، وعندها نخبرك بالسبب.
          </p>
          <p>
            وما سبق أن أُرسل إلى المستشفى يخضع لسياسة الاحتفاظ لديه هو، ويُطلب الحذف منه
            مباشرة.
          </p>

          <h2>حقوقك</h2>
          <ul>
            <li>أن تطلب نسخة مما لدينا عنك.</li>
            <li>أن تطلب تصحيح أي معلومة خاطئة.</li>
            <li>أن تطلب حذف ملفك.</li>
            <li>أن تسحب موافقتك على الإحالة قبل تنفيذها.</li>
            <li>أن ترفض في أي مرحلة بلا تبرير وبلا ضغط.</li>
          </ul>

          <h2>التحليلات وملفات الارتباط</h2>
          <p>
            الموقع في وضعه الحالي <strong>لا يستعمل ملفات ارتباط تتبّعية ولا أدوات تحليلات
            ولا بكسلات إعلانية</strong>، ولا يُحمّل أي سكربت من جهة خارجية. والخطوط
            مستضافة على الموقع نفسه فلا تُرسَل أي بيانات لخوادم خارجية.
          </p>
          <p>
            وإن أضفنا أداة قياس زيارات مستقبلاً، سنحدّث هذه الصفحة ونبيّن ما تجمعه قبل
            تفعيلها.
          </p>

          <h2>الأطفال</h2>
          <p>
            حين يكون المريض طفلاً، نتعامل مع وليّ أمره حصراً، ولا نتواصل مع قاصر مباشرة،
            ونطبّق على بياناته الحماية نفسها.
          </p>

          <h2>كيف تتواصل بشأن خصوصيتك</h2>
          <p>
            عبر واتساب على <span class="num">{WHATSAPP.display}</span> — اكتب «طلب خصوصية»
            وبيّن ما تريد: نسخة، أو تصحيح، أو حذف.
          </p>

          <h2>تحديث هذه السياسة</h2>
          <p>
            قد تُحدَّث هذه الصفحة إن تغيّرت طريقة عملنا. وأي تغيير جوهري — مثل إضافة أداة
            تحليلات أو نموذج تواصل — يُذكر هنا صراحةً قبل تفعيله.
          </p>
        </div>
      </div>
    </div>
  </article>
</Layout>
