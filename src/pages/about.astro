---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Cta from "../components/Cta.astro";
import { SITE, ROLE } from "../lib/site";
import { graph, organization, website, webPage, breadcrumbs } from "../lib/schema";

const title = "من نحن — TransplantBridge";
const description =
  "من نحن: جهة تنسيق مستقلة لزرع الكبد وزراعة الكلى. ماذا نفعل بالضبط، وما لا نفعله، وكيف نُعوَّض، وما حدود دورنا.";
const path = "/about";

const crumbs = [
  { name: "الرئيسية", path: "/" },
  { name: "من نحن", path },
];

const jsonLd = graph([
  organization(),
  website(),
  webPage({ path, title, description }),
  breadcrumbs(crumbs),
]);

const doList = [
  "نقرأ ملفك الطبي ونخبرك بما ينقصه قبل أي خطوة.",
  "نجهّز الملف بالشكل والترتيب الذي يطلبه فريق الزراعة.",
  "نشرح لك الشروط والمخاطر بلغة مفهومة، بما فيها ما قد لا يعجبك.",
  "نوصلك إلى المنسق الدولي في مستشفى متخصص، ونسجّل حالتك باسمك.",
  "نبقى على تواصل معك ومع المنسق بعد الإحالة.",
];

const dontList = [
  "لا نشخّص ولا نصف علاجاً ولا نتخذ أي قرار طبي.",
  "لا نضمن قبولك في أي مستشفى، ولا نضمن نتيجة علاجية.",
  "لا نُحدد أهليتك للزراعة — المستشفى والفريق المعالج وحدهما.",
  "لا نوفّر متبرعاً ولا نساعد في إيجاده. المتبرع شأن عائلتك والقانون.",
  "لا نشتري أعضاء ولا نبيعها ولا نتوسط في ذلك بأي صورة.",
  "لا ننشر أسعاراً من عندنا ولا نسب نجاح بلا مصدر.",
  "لا ندّعي أننا مستشفى أو وكيل معتمد لأي مستشفى.",
];
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <article class="wrap pt-32 pb-8 sm:pt-36">
    <div class="mx-auto max-w-[52rem]">
      <Breadcrumbs items={crumbs} />

      <header>
        <p class="chip">من نحن</p>
        <h1 class="mt-5 font-display text-[2.125rem] font-extrabold leading-[1.3] tracking-tightest text-white sm:text-[2.75rem]">
          جهة تنسيق مستقلة — لا مستشفى ولا طبيب
        </h1>
        <p class="mt-6 text-[1.0625rem] leading-[1.95] text-ink-100 sm:text-lg">{ROLE.weAre}</p>
      </header>

      <div class="panel mt-10">
        <div class="prose-ar">
          <h2>لماذا وُجد {SITE.name}؟</h2>
          <p>
            المريض العربي الذي يحتاج زرع كبد أو زراعة كلى يصطدم بثلاث مشكلات معاً: معلومات
            عربية شحيحة ومتناقضة، وأسعار منشورة لا يُعرف ما تشمله، ووسطاء يَعِدون بما لا
            يملكون. فيُنفق أسابيع في الاتجاه الخطأ، وأحياناً يكتشف بعد كل ذلك أن حالته لا
            تنطبق عليها الشروط أصلاً.
          </p>
          <p>
            نحن نعمل على الطرف العملي من المشكلة: أن تعرف <strong>مبكراً</strong> ما يلزمك،
            وأن يصل ملفك إلى من يقرأه فعلاً، وأن تُقال لك الحقيقة حتى لو كانت أن المسار غير
            متاح لك الآن.
          </p>

          <h2>ماذا نفعل بالضبط</h2>
          <ul>{doList.map((t) => <li set:html={t} />)}</ul>

          <h2>ما لا نفعله</h2>
          <p>هذه القائمة ليست تحفظاً قانونياً — هي حدود حقيقية نلتزم بها:</p>
          <ul>{dontList.map((t) => <li set:html={t} />)}</ul>

          <h2>كيف نُعوَّض — إفصاح صريح</h2>
          <p>
            نعمل مع <strong>مستشفى شريك في تركيا</strong> متخصص في زراعة الكبد والكلى،
            و<strong>نحصل على تعويض من المستشفى</strong> مقابل التنسيق وإحالة الحالات إليه.
          </p>
          <p>
            نقول ذلك صراحةً لأن من حقك أن تعرف مصلحة من يتحدث إليك. ويعني هذا أيضاً أن
            عليك أن تسألنا وتسأل المستشفى، وأن تقارن، وأن ترفض إن لم تقتنع — ولن نضغط عليك.
          </p>
          <p>
            وأي مبلغ قد يُطلب منك في أي مرحلة يُذكر لك <strong>مكتوباً ومسبقاً</strong>،
            ولا نطلب أي دفعة قبل أن يُقرأ ملفك ويُعرف إن كان مسارك ممكناً أصلاً.
          </p>

          <h2>لماذا لا نذكر اسم المستشفى هنا؟</h2>
          <p>
            لأن ذكر اسم مستشفى على صفحة عامة يحوّل الصفحة إلى إعلان، ولأن المركز المناسب
            يختلف بحسب العضو ونوع الحالة وعمر المريض. فنحدد المستشفى بعد قراءة ملفك، ونخبرك
            باسمه وبما يؤهله لحالتك قبل أي تواصل.
          </p>
          <p>
            ونحن لم نتحقق بأنفسنا من اعتمادات أي مركز، ونقول ذلك بوضوح. ونعطيك في صفحة
            <a href="/transplant-hospitals-turkey">كيف تختار مستشفى</a> المعايير التي تقيّم
            بها أي مركز — بما فيها المركز الذي نرشّحه لك.
          </p>

          <h2>موقفنا من الاتجار بالأعضاء</h2>
          <p>{ROLE.noTrafficking}</p>
          <p>
            وإن وصلنا طلب من هذا النوع فلا نردّ عليه ولا نحيله إلى أحد. ونحذّر كل مريض من أي
            جهة تعرض عليه «تدبير متبرع» — فهي تعرّضه للمساءلة القانونية ولخطر جسيم على حياته،
            لأن ما يجري خارج الرقابة الطبية لا ضمانة فيه لأحد.
          </p>

          <h2>من يكتب المحتوى؟</h2>
          <p>
            يُكتب المحتوى على أساس مصادر عامة ومراجعة تحريرية، و<strong>ليس بقلم طبيب</strong>،
            ولا ندّعي صفة طبية لكاتبه. ولذلك تجد في كل صفحة إخلاء مسؤولية طبياً، وامتناعاً عن
            نشر أرقام ونسب بلا مصدر.
          </p>
          <p>
            وحيثما احتاجت معلومة إلى مراجعة طبية أو قانونية قبل الاعتماد عليها، نقولها
            صراحةً في موضعها بدل أن نمرّرها كأنها مؤكدة.
          </p>

          <h2>كيف تتواصل معنا</h2>
          <p>
            عبر واتساب حصراً، وهو القناة التي نستقبل بها الملفات ونردّ عليها. لا نطلب منك
            بيانات أكثر مما يلزم لقراءة ملفك، ولا ننشر بيانات أي مريض.
          </p>
        </div>
      </div>

      <div class="mt-16">
        <Cta
          title="أرسل ملفك ونخبرك بما ينقصه"
          body="لا نطلب أي التزام قبل أن نقرأ ملفك ونوضّح لك إن كان المسار ممكناً."
          placement="about"
        />
      </div>
    </div>
  </article>
</Layout>
