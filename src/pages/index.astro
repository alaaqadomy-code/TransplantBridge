  },
  {
    t: "يستعجلك ويضغط عليك",
    d: "«المكان محجوز» و«السعر يرتفع غداً» أساليب بيع لا طبّ. القرار الذي تتخذه هنا مصيري ومن حقك أن تأخذ وقتك وتسأل وتستشير وتطلب رأياً ثانياً — ولا يصحّ أن يضغط عليك أحد.",
  },
  {
    t: "يطلب المال كاملاً مقدَّماً لحساب شخصي",
    d: "الدفع يكون لحساب المستشفى الرسمي بإيصالات باسمك، لا لحساب شخص أو وسيط. واطلب توضيح جدول الدفع وما يُرَد منه إن لم تُجرَ العملية، مكتوباً قبل أن تدفع شيئاً.",
  },
  {
    t: "يرفض أن يكتب شيئاً",
    d: "كل ما يقال شفاهةً يُنسى ويُفهم خطأً. اطلب الإجابات مكتوبةً: بنود العرض، ومدة الإقامة، وما يحدث لو طالت العناية المركزة، ومن يتابعك بعد العودة. والتردد في الكتابة معلومة بنفسه.",
  },
];

/** نظرة سريعة على العضوين — ليعرف الزائر أين يقف قبل أن يدخل الصفحات التفصيلية */
const organs = [
  {
    t: "زرع الكبد",
    lead: "الكبد عضو واحد لا بديل اصطناعي عنه: لا يوجد جهاز يحلّ محلّه كما يفعل الغسيل مع الكلى. ولهذا تكون الزراعة في فشل الكبد المتقدم هي العلاج الجذري الوحيد، ويكون التوقيت فيها أهم مما يُظنّ.",
    points: [
      "<strong>ما يميّزه:</strong> الكبد يتجدّد. فيُؤخذ من المتبرع الحي جزء من كبده، وينمو الجزء المتبقي عنده والجزء المزروع عند المريض نحو الحجم الوظيفي الذي يحتاجه كلٌّ منهما خلال أسابيع إلى أشهر.",
      "<strong>دواعيه الأشهر:</strong> التليف المتقدم بأسبابه المختلفة، وبعض أورام الكبد بمعايير اختيار محددة، وأمراض وراثية واستقلابية عند الأطفال، وفشل كبدي حاد يُدار كحالة طارئة.",
      "<strong>ما يُقاس قبل القرار:</strong> البيليروبين وزمن التخثر والألبومين والكرياتينين، مع علامات سريرية كالاستسقاء والتشوّش الذهني ونزف الدوالي.",
      "<strong>الأدقّ تقنياً:</strong> مطابقة حجم الجزء المزروع لوزن المريض وتجويف بطنه، وتشريح الأوعية والقنوات الصفراوية — وهو أكثر ما يُرفض بسببه متبرع سليم تماماً.",
    ],
    href: "/liver-transplant",
    cta: "دليل زرع الكبد كاملاً",
  },
  {
    t: "زراعة الكلى",
    lead: "للكلى بديل يُبقي المريض حياً هو الغسيل، لكنه يعوّض جزءاً من الوظيفة لا كلّها. والزراعة الناجحة تعيد وظيفة أقرب إلى الطبيعي وتحرّر المريض من جدول الغسيل — وهي خيار لا يناسب كل مريض.",
    points: [
      "<strong>ما يفاجئ الكثيرين:</strong> لا تُستأصل الكليتان الأصليتان عادةً، بل تُزرع الكلية الجديدة في أسفل البطن وتُوصل بأوعية الحوض والمثانة. فيصبح في الجسم ثلاث كلى، وهذا طبيعي ومقصود.",
      "<strong>شرط التوافق:</strong> بعد فصيلة الدم تأتي الفحوصات المناعية والنسيجية، وقد تُنهي المسار وحدها. ولهذا تُنجَز قبل السفر لا بعده.",
      "<strong>البديل القائم:</strong> الغسيل الدموي أو البريتوني، ولكلٍّ منهما أثره في نمط الحياة والعمل والسفر. والمقارنة الصريحة بينهما وبين الزراعة قرار يُتخذ مع طبيب الكلى.",
      "<strong>بعد العملية:</strong> مثبطات مناعة بالتزام لا يُساوَم عليه، ومراجعات متقاربة في الأشهر الأولى، واحتياطات عدوى يحددها الفريق.",
    ],
    href: "/kidney-transplant",
    cta: "دليل زراعة الكلى كاملاً",
  },
];

const clusters = [
  { t: "التبرع بالكبد", d: "من يصلح متبرعاً، وكيف تتم العملية.", href: "/liver-donation" },
  { t: "خطورة التبرع بالكبد", d: "المخاطر والمضاعفات على المتبرع بصراحة.", href: "/liver-donor-risks" },
  { t: "التبرع بالكلى", d: "الإجراءات والشروط وما يحدث بعدها.", href: "/kidney-donation" },
  { t: "نسبة نجاح زراعة الكلى", d: "ما تقوله المصادر عن النتائج وعمر العضو.", href: "/kidney-transplant-success-rate" },
  { t: "فترة العزل بعد زراعة الكلى", d: "الحياة والأدوية بعد العملية.", href: "/after-kidney-transplant" },
  { t: "أفضل دولة لزراعة الكلى", d: "كيف تقارن الوجهات وتختار.", href: "/best-country-kidney-transplant" },
];
---

<Layout title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- ══════════ البطل ══════════ -->
  <section class="relative">
    <div class="wrap pt-32 pb-16 sm:pt-36 sm:pb-20 lg:pt-40 lg:pb-24">
      <div class="max-w-3xl">
        <p class="chip animate-rise">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-shifa-300 opacity-70 animate-halo"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-shifa-300"></span>
          </span>
          تنسيق علاج مستقل · التعافي يبدأ من هنا
        </p>

        <h1 class="mt-7 font-display text-[2.5rem] font-extrabold leading-[1.3] tracking-tightest text-white sm:text-[3.25rem] sm:leading-[1.24] lg:text-[3.75rem]">
          <span>زرع الكبد وزراعة الكلى: </span><br class="hidden sm:block" /><span
            class="text-gradient animate-shimmer inline-block pb-[0.12em]">نسير معك من أول خطوة</span
          >
        </h1>

        <p class="mt-7 max-w-2xl text-[1.0625rem] leading-[1.95] text-ink-200 sm:text-lg">
          نقرأ ملفك الطبي، ونجهّزه بالشكل الذي يطلبه فريق الزراعة، ونوصلك إلى <strong class="font-bold text-white">المنسق الدولي في مستشفى متخصص في تركيا</strong>، ونبقى معك بعد الإحالة. وقبل ذلك كله نشرح لك بصدق: من يصلح متبرعاً، وما المخاطر، وما الذي لا نستطيع ضمانه.
        </p>

        <!-- طمأنة صريحة: ثلاث جمل كلها صحيحة ومن سياستنا المعلنة، بلا أي وعد -->
        <ul class="mt-9 grid gap-3 sm:grid-cols-3">
          {[
            "نقرأ ملفك قبل أي كلام عن التكلفة",
            "نخبرك بصراحة إن كانت حالتك لا تستوفي الشروط",
            "لا نَعِد بقبول ولا بنتيجة — القرار للمستشفى",
          ].map((t) => (
            <li class="flex items-start gap-2.5 rounded-2xl border border-white/10 bg-white/[.04] px-4 py-3 text-[0.875rem] leading-snug text-ink-200">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-shifa-300" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- ═══ حركة النبض: من متعثّر إلى مستقر ═══
           يبدأ الخط من اليمين (حيث يبدأ القارئ العربي) ضعيفاً ومتعرّجاً،
           ويصير كلما تقدّم يساراً منتظماً وقوياً وهادئاً. بلا كلمة واحدة،
           وبلا وعد — إيحاء بصري بالرحلة نحو الاستقرار. -->
      <figure class="relative mt-14 sm:mt-16" role="img" aria-label="رسم توضيحي: خط نبض يبدأ متعثّراً من اليمين ويستقر تدريجياً نحو اليسار، فوق قوس جسر">
        <div class="pointer-events-none absolute inset-x-0 -bottom-10 -top-10 bg-gradient-to-l from-transparent via-shifa-500/[.10] to-transparent blur-2xl" aria-hidden="true"></div>

        <svg viewBox="0 0 1200 270" class="relative block w-full" fill="none" aria-hidden="true">
          <defs>
            <!-- RTL: الطرف الأيمن (x1=1) باهت ومضطرب، والأيسر حيّ ومستقر -->
            <linearGradient id="ecgGrad" x1="1" y1="0" x2="0" y2="0">
              <stop offset="0" stop-color="#4E6B7B"/>
              <stop offset=".28" stop-color="#0B7A6B"/>
              <stop offset=".60" stop-color="#0FBFA4"/>
              <stop offset="1" stop-color="#5FE9D0"/>
            </linearGradient>
            <linearGradient id="bridgeGrad" x1="1" y1="0" x2="0" y2="0">
              <stop offset="0" stop-color="#4E6B7B" stop-opacity=".3"/>
              <stop offset="1" stop-color="#5FE9D0" stop-opacity=".75"/>
            </linearGradient>
          </defs>

          <!-- خط الأساس الباهت -->
          <path d={`M40,${BASE}H1184`} stroke="#ffffff" stroke-opacity=".06" stroke-width="1"/>

          <!-- قوس الجسر ودعاماته — عنصر ثانوي هادئ تحت النبض -->
          <g class="ecg-bridge">
            <path d="M60,244C60,206 300,182 622,182S1140,206 1140,244" stroke="url(#bridgeGrad)" stroke-width="2.4" stroke-linecap="round"/>
            <path d="M60,244H1140" stroke="url(#bridgeGrad)" stroke-width="1.8" stroke-linecap="round" stroke-opacity=".65"/>
            <path d="M300,244v-54M622,244v-62M944,244v-54" stroke="#5FE9D0" stroke-opacity=".26" stroke-width="1.5" stroke-linecap="round"/>
          </g>

          <!-- النبض المتعثّر (يمين) — يخفت بعد اكتمال الرسم فيبرز الاستقرار -->
          <g class="ecg-fade-start">
            <path
              d={chaosPath}
              stroke="url(#ecgGrad)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
              class="ecg-line" style="stroke-dasharray:420;stroke-dashoffset:420;animation-duration:1.2s"
            />
          </g>

          <!-- الانتقال ثم الاستقرار (يسار) -->
          <path
            d={steadyPath}
            stroke="url(#ecgGrad)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"
            class="ecg-line"
          />

          <!-- النهاية المستقرة: نقطة حيّة بهالة -->
          <circle cx="604" cy={BASE} r="0" fill="none"/>
          <circle cx="40" cy={BASE} r="22" fill="#5FE9D0" fill-opacity=".13" class="ecg-end-halo"/>
          <circle cx="40" cy={BASE} r="7" fill="#5FE9D0" class="ecg-end"/>
          <!-- البداية المتعثّرة: نقطة باهتة -->
          <circle cx="1180" cy={BASE} r="4" fill="#4E6B7B" class="ecg-end"/>
        </svg>
      </figure>

      <div class="mt-12 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={WHATSAPP.link(WHATSAPP.defaultMessage)} target="_blank" rel="noopener" data-wa="hero" class="btn-primary !px-8 !py-4 !text-base">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.02a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.22 8.22 0 1 1 6.98 3.87Z"/>
          </svg>
          اطلب تقييم حالتك
        </a>
        <a href="#clusters" class="btn-ghost !px-8 !py-4 !text-base">تصفّح المعلومات أولاً</a>
      </div>

      <p class="mt-8 max-w-xl text-[0.8125rem] leading-relaxed text-ink-400">{ROLE.weAreNot}</p>
    </div>
  </section>

  <!-- ══════════ المدخلان ══════════ -->
  <section class="wrap pb-6">
    <div class="grid gap-6 lg:grid-cols-2">
      {[
        { h: "زرع الكبد", d: "ما هو زرع الكبد ومتى يلزم، وكيف تُجرى العملية، ومن المرشّح لها، وشروط المتبرع ومخاطره.", href: "/liver-transplant",
          icon: "M4 9c2.5-3 6-4 9-4s5 1 6 2c1.4 1.5 1 4-1 5.5-1.6 1.2-2 2.3-2.3 3.6-.3 1.4-1.3 2.4-2.9 2.4-2 0-3-1.4-4.3-2.6C6.6 14.4 4 13 4 9Z" },
        { h: "زراعة الكلى", d: "خطوات العملية وشروط المتبرع ونسب النجاح وعمر العضو المزروع، وفترة العزل والحياة بعدها.", href: "/kidney-transplant",
          icon: "M9 4c3 0 5 2.4 5 5.5 0 1.6-.6 2.3-.6 3.5 0 1.3 1 1.8 1 3.2C14.4 18.6 12.4 20 10 20c-3.3 0-6-3.2-6-8s2.7-8 5-8Z" },
      ].map((c) => (
        <a href={c.href} class="card card-lift group overflow-hidden !p-8 sm:!p-10" data-reveal>
          <div class="pointer-events-none absolute -left-20 -top-20 h-52 w-52 rounded-full bg-shifa-400/10 blur-2xl transition-transform duration-700 group-hover:scale-150" aria-hidden="true"></div>
          <div class="relative">
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-shifa-400 to-shifa-700 text-white shadow-glow">
              <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d={c.icon} stroke-linejoin="round"/>
              </svg>
            </span>
            <h2 class="mt-6 font-display text-[1.75rem] font-bold text-white sm:text-3xl">{c.h}</h2>
            <p class="mt-3.5 text-[1.0625rem] leading-relaxed text-ink-300">{c.d}</p>
            <span class="mt-6 inline-flex items-center gap-2 font-display text-[0.9375rem] font-semibold text-shifa-300">
              ادخل القسم
              <svg viewBox="0 0 24 24" class="h-4 w-4 rotate-180 transition-transform duration-300 group-hover:-translate-x-1.5" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ══════════ العلاج في تركيا ══════════ -->
  <section class="wrap py-24 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div data-reveal>
        <p class="chip">الوجهة</p>
        <h2 class="mt-5 text-[2rem] font-bold sm:text-[2.5rem]">العلاج في تركيا: ما الذي يسأل عنه المرضى العرب</h2>
        <p class="mt-5 text-[1.0625rem] leading-[1.95] text-ink-200">
          تركيا من أكثر الوجهات التي يسأل عنها المريض العربي لزراعة الأعضاء، لقربها وتوفر
          مراكز متخصصة فيها ووجود منسقين يتحدثون العربية. لكن قبل أي مقارنة سعر، هناك شرط
          واحد يحسم إن كان المسار ممكناً أصلاً.
        </p>
        <p class="mt-4 text-[1.0625rem] leading-[1.95] text-ink-200">
          المريض القادم من خارج تركيا <strong class="font-bold text-white">لا يُدرج عادةً على
          قوائم المتبرعين المتوفين</strong> هناك، لأن تلك القوائم مخصصة لمواطني الدولة.
          ومعنى ذلك عملياً أنك تحتاج في الغالب <strong class="font-bold text-white">متبرعاً
          حيّاً من أقاربك</strong> — وهذا أول ما يسأل عنه فريق الزراعة، لا آخره.
        </p>
        <p class="mt-4 text-[1.0625rem] leading-[1.95] text-ink-200">
          ولهذا نبدأ معك من الملف لا من السعر: نقرأ تقاريرك وتقارير المتبرع المحتمل، ونخبرك
          إن كان المسار متاحاً لك قبل أن تُنفق أسبوعاً في مقارنة عروض.
        </p>
        <p class="mt-4 text-[1.0625rem] leading-[1.95] text-ink-200">
          ونضيف ما لا يقوله كثيرون: قرب تركيا وسهولة إجراءاتها مزيّتان لوجستيتان لا طبيّتان،
          ومستوى المراكز هناك متفاوت كتفاوته في أي بلد آخر. فلا تجعل سرعة الرد أو جمال
          الإعلان بديلاً عن سؤال واحد: ما حجم نشاط برنامج الزراعة لعضوي في هذا المركز
          تحديداً، ومن الفريق الذي سيتولّى حالتي بالاسم؟
        </p>
      </div>

      <div class="grid gap-4 self-center" data-reveal>
        {[
          { t: "زرع الكبد في تركيا", d: "من يبحث عن زراعة الكبد في تركيا يبدأ من هنا: الشرط الذي يسبق كل شيء، والمستندات، ومدة الإقامة.", h: "/liver-transplant-turkey" },
          { t: "زراعة الكلى في تركيا", d: "شرط المتبرع القريب، والتوافق النسيجي، وماذا لو كان المتبرع غير متوافق.", h: "/kidney-transplant-turkey" },
          { t: "تكلفة زراعة الكلى وتكلفة زراعة الكبد", d: "لماذا تتناقض الأرقام المنشورة، وما يجب أن يوضحه أي عرض سعر قبل أن تقارن.", h: "/transplant-cost" },
          { t: "مستشفيات زراعة الكلى في تركيا", d: "معايير اختيار المركز، وعلامات التحذير.", h: "/transplant-hospitals-turkey" },
        ].map((c) => (
          <a href={c.h} class="card card-lift group !p-6">
            <div class="relative flex items-start justify-between gap-4">
              <div>
                <h3 class="font-display text-[1.0625rem] font-bold text-white transition-colors group-hover:text-shifa-200">{c.t}</h3>
                <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-300">{c.d}</p>
              </div>
              <svg viewBox="0 0 24 24" class="mt-1 h-4 w-4 shrink-0 rotate-180 text-shifa-300 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ أربعة أسئلة تحسم المسار ══════════ -->
  <section class="wrap pb-24 sm:pb-28">
    <div class="max-w-2xl" data-reveal>
      <p class="chip">قبل أي شيء</p>
      <h2 class="mt-5 text-[2rem] font-bold sm:text-[2.5rem]">أربعة أسئلة تحسم المسار قبل أن تقارن مستشفى أو سعراً</h2>
      <p class="mt-5 text-[1.0625rem] leading-[1.95] text-ink-200">
        معظم من يراسلنا يبدأ من السؤال الأخير: أي مستشفى وكم السعر. والترتيب الصحيح
        معاكس تماماً — فهذه الأسئلة الأربعة هي ما يحدّد إن كان المسار متاحاً لك من أصله،
        وإجابتها توفّر عليك أسابيع ومالاً وقلقاً.
      </p>
    </div>

    <ol class="mt-14 grid gap-6 lg:grid-cols-2">
      {decisive.map((q) => (
        <li class="card !p-8" data-reveal>
          <div class="relative flex items-start gap-5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-shifa-400 to-shifa-700 font-display text-lg font-bold text-white shadow-glow">{q.n}</span>
            <div>
