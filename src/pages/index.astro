              <svg viewBox="0 0 24 24" class="mt-1 h-4 w-4 shrink-0 text-shifa-300 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
