  <!-- ══════════ أسئلة شائعة ══════════ -->
  <section class="wrap pb-24 sm:pb-28">
    <div class="mx-auto max-w-[52rem]">
      <div class="max-w-2xl" data-reveal>
        <p class="chip">أسئلة شائعة</p>
        <h2 class="mt-5 text-[2rem] font-bold sm:text-[2.5rem]">الأسئلة التي يبدأ بها معظم من يراسلنا</h2>
      </div>
      <div class="mt-10 space-y-3">
        {homeFaqs.map((f) => (
          <details class="group rounded-3xl border border-white/10 bg-white/[.04] px-6 py-5 transition-colors open:border-shifa-300/30 open:bg-white/[.06]" data-reveal>
