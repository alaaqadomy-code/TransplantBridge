---
import Layout from "../layouts/Layout.astro";
import Cta from "../components/Cta.astro";
import { SITE, ROLE, WHATSAPP } from "../lib/site";
import { graph, organization, website, webPage } from "../lib/schema";

const title = "زرع الكبد وزراعة الكلى — دليل عربي وتنسيق العلاج | TransplantBridge";
const description =
  "دليل عربي لزرع الكبد وزراعة الكلى: شروط المتبرع والمخاطر ونسب النجاح وما بعد العملية، مع تنسيق التواصل مع المستشفى. معلومات موثقة بلا وعود.";

const jsonLd = graph([
  organization(),
  website(),
  webPage({ path: "/", title, description }),
]);

const steps = [
  {
    n: "١",
    t: "ترسل ملفك",
    d: "التقارير الطبية والتحاليل والأشعة عبر واتساب، ووصف مختصر لحالتك.",
  },
  {
    n: "٢",
    t: "نقرأه ونجهّزه",
    d: "نرتّب الملف بالشكل الذي يطلبه فريق الزراعة، ونوضّح لك ما ينقصه.",
  },
  {
    n: "٣",
    t: "نوصلك للمنسق",
    d: "نحيلك إلى المنسق الدولي في المستشفى المتخصص، ونسجّل حالتك باسمك.",
  },
  {
    n: "٤",
    t: "نتابع معك",
    d: "نبقى على تواصل معك ومع المنسق بعد الإحالة، حتى تستقر خطوتك التالية.",
  },
];

const honesty = [
  {
    t: "المتبرع شرط أساسي",
    d: "المستشفى يشترط في الغالب متبرعاً حيّاً من ذوي القرابة. نقولها لك من أول سطر، لا بعد أن تُنفق وقتك.",
    href: "/kidney-donor-requirements",
    cta: "اقرأ شروط التبرع",
  },
  {
    t: "لا نخترع أسعاراً",
    d: "الأرقام المنشورة على الإنترنت متناقضة. نشرح لك لماذا تختلف، وما الذي يجب أن يحتويه أي عرض سعر.",
    href: "/transplant-cost",
    cta: "كيف تقرأ عرض السعر",
  },
  {
    t: "لا نَعِد بنتيجة",
    d: "لا نضمن قبول مريض ولا نتيجة علاجية. القرار الطبي للمستشفى والفريق المعالج وحدهما.",
    href: "/about",
    cta: "من نحن وحدود دورنا",
  },
];

const clusters = [
  { t: "التبرع بالكبد", d: "من يصلح متبرعاً، وكيف تتم العملية.", href: "/liver-donation" },
  { t: "خطورة التبرع بالكبد", d: "المخاطر والمضاعفات على المتبرع بصراحة.", href: "/liver-donor-risks" },
  { t: "التبرع بالكلى", d: "الإجراءات والشروط وما يحدث بعدها.", href: "/kidney-donation" },
  { t: "نسبة نجاح زراعة الكلى", d: "ما تقوله المصادر عن النتائج وعمر العضو.", href: "/kidney-transplant-success-rate" },
  { t: "فترة العزل بعد زراعة الكلى", d: "الحياة والأدوية بعد العملية.", href: "/after-kidney-transplant" },
  { t: "أفضل دولة لزراعة الكلى", d: "كيف تقارن الوجهات وتختار.", href: "/best-country-kidney-transplant" },
];
---

<Layout title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- ===== Hero ===== -->
  <section class="relative overflow-hidden">
    <!-- أشكال عضوية ناعمة توحي بالتجدد -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -right-24 -top-32 h-[30rem] w-[30rem] rounded-full bg-shifa-200/40 blur-3xl animate-drift"></div>
      <div class="absolute -left-32 top-24 h-[22rem] w-[22rem] rounded-full bg-amal-light/20 blur-3xl animate-drift" style="animation-delay:-5s"></div>
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-l from-transparent via-shifa-200 to-transparent"></div>
    </div>

    <div class="wrap py-20 sm:py-28 lg:py-32">
      <div class="max-w-3xl">
        <p class="chip animate-rise">
          <span class="h-1.5 w-1.5 rounded-full bg-shifa-500"></span>
          دليل عربي مستقل · زرع الكبد وزراعة الكلى
        </p>

        <h1 class="mt-6 text-[2.5rem] font-semibold leading-[1.15] sm:text-6xl lg:text-[4.25rem]">
          <span class="text-gradient animate-shimmer">التعافي يبدأ من هنا</span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-[1.9] text-ink-600 sm:text-xl">
          معلومات واضحة وموثقة عن <strong class="font-semibold text-ink-900">زرع الكبد</strong> و<strong class="font-semibold text-ink-900">زراعة الكلى</strong>: من يصلح متبرعاً، وما المخاطر، وماذا تقول المصادر عن النتائج، وما الذي يحدث بعد العملية — ثم نساعدك في تجهيز ملفك وإيصاله إلى المستشفى.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={WHATSAPP.link(WHATSAPP.defaultMessage)} target="_blank" rel="noopener" data-wa="hero" class="btn-primary !px-7 !py-3.5 !text-[1.0625rem]">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.02a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.22 8.22 0 1 1 6.98 3.87Z"/>
            </svg>
            اطلب تقييم حالتك
          </a>
          <a href="#clusters" class="btn-ghost !px-7 !py-3.5 !text-[1.0625rem]">تصفّح المعلومات أولاً</a>
        </div>

        <p class="mt-6 text-[0.875rem] text-ink-400">{ROLE.weAreNot}</p>
      </div>
    </div>
  </section>

  <!-- ===== المدخلان ===== -->
  <section class="wrap pb-6">
    <div class="grid gap-5 lg:grid-cols-2">
      <a href="/liver-transplant" class="card card-lift group relative overflow-hidden !p-8 sm:!p-10" data-reveal>
        <div class="pointer-events-none absolute -left-10 -top-10 h-40 w-40 rounded-full bg-shifa-100/70 blur-2xl transition-transform duration-700 group-hover:scale-125" aria-hidden="true"></div>
        <div class="relative">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-shifa-50 text-shifa-700">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M4 9c2.5-3 6-4 9-4s5 1 6 2c1.4 1.5 1 4-1 5.5-1.6 1.2-2 2.3-2.3 3.6-.3 1.4-1.3 2.4-2.9 2.4-2 0-3-1.4-4.3-2.6C6.6 14.4 4 13 4 9Z" stroke-linejoin="round"/>
            </svg>
          </span>
          <h2 class="mt-5 font-display text-2xl font-semibold text-ink-900 sm:text-[1.75rem]">زرع الكبد</h2>
          <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-600">
            ما هو زرع الكبد ومتى يلزم، وكيف تُجرى العملية، ومن المرشّح لها، وشروط المتبرع ومخاطره.
          </p>
          <span class="mt-5 inline-flex items-center gap-2 font-display text-[0.9375rem] font-medium text-shifa-700">
            ادخل القسم
            <svg viewBox="0 0 24 24" class="h-4 w-4 rotate-180 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>

      <a href="/kidney-transplant" class="card card-lift group relative overflow-hidden !p-8 sm:!p-10" data-reveal>
        <div class="pointer-events-none absolute -left-10 -top-10 h-40 w-40 rounded-full bg-shifa-100/70 blur-2xl transition-transform duration-700 group-hover:scale-125" aria-hidden="true"></div>
        <div class="relative">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-shifa-50 text-shifa-700">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M9 4c3 0 5 2.4 5 5.5 0 1.6-.6 2.3-.6 3.5 0 1.3 1 1.8 1 3.2C14.4 18.6 12.4 20 10 20c-3.3 0-6-3.2-6-8s2.7-8 5-8Z" stroke-linejoin="round"/>
              <path d="M14 12.8c1.6-.3 2.6-1.3 2.6-2.6" stroke-linecap="round"/>
            </svg>
          </span>
          <h2 class="mt-5 font-display text-2xl font-semibold text-ink-900 sm:text-[1.75rem]">زراعة الكلى</h2>
          <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-600">
            خطوات العملية وشروط المتبرع ونسب النجاح وعمر العضو المزروع، وفترة العزل والحياة بعدها.
          </p>
          <span class="mt-5 inline-flex items-center gap-2 font-display text-[0.9375rem] font-medium text-shifa-700">
            ادخل القسم
            <svg viewBox="0 0 24 24" class="h-4 w-4 rotate-180 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ===== كيف نعمل ===== -->
  <section class="wrap py-20 sm:py-24">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-3xl font-semibold sm:text-4xl">كيف نعمل</h2>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-600">{ROLE.weAre}</p>
    </div>

    <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <li class="card card-lift relative" data-reveal>
          <span class="grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-br from-shifa-500 to-shifa-700 font-display text-lg font-semibold text-white">{s.n}</span>
          <h3 class="mt-5 font-display text-lg font-semibold text-ink-900">{s.t}</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-500">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ===== الصراحة ===== -->
  <section class="border-y border-shifa-100 bg-white">
    <div class="wrap py-20 sm:py-24">
      <div class="max-w-2xl" data-reveal>
        <h2 class="text-3xl font-semibold sm:text-4xl">ثلاثة أشياء نقولها بصراحة</h2>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-600">
          قرار الزراعة ثقيل، ويستحق معلومة صادقة لا تسويقاً.
        </p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {honesty.map((h) => (
          <article class="card card-lift flex flex-col" data-reveal>
            <h3 class="font-display text-xl font-semibold text-ink-900">{h.t}</h3>
            <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">{h.d}</p>
            <a href={h.href} class="mt-5 inline-flex items-center gap-2 font-display text-[0.9375rem] font-medium text-shifa-700 transition-colors hover:text-shifa-800">
              {h.cta}
              <svg viewBox="0 0 24 24" class="h-4 w-4 rotate-180" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== أقسام أخرى ===== -->
  <section id="clusters" class="wrap py-20 sm:py-24">
    <h2 class="text-3xl font-semibold sm:text-4xl" data-reveal>ابدأ من سؤالك</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {clusters.map((c) => (
        <a href={c.href} class="group rounded-4xl border border-shifa-100 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-shifa-200 hover:shadow-lift" data-reveal>
          <h3 class="font-display text-[1.0625rem] font-semibold text-ink-900 transition-colors group-hover:text-shifa-800">{c.t}</h3>
          <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-500">{c.d}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ===== دعوة التواصل ===== -->
  <section class="wrap pb-8">
    <Cta
      title="جاهز تبدأ خطوتك الأولى؟"
      body="أرسل تقاريرك الطبية عبر واتساب، ونوضّح لك ما ينقص الملف، ونوصلك إلى المنسق الدولي في المستشفى."
      placement="home"
    />
  </section>
</Layout>
