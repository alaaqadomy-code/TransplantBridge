---
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Disclaimer from "../components/Disclaimer.astro";
import Cta from "../components/Cta.astro";
import PriceTable from "../components/PriceTable.astro";
import { LIVER_PRICES, KIDNEY_PRICES, COUNTRY_LIVER, COUNTRY_KIDNEY, COUNTRY_SOURCE } from "../content/prices";
import { PAGES, bySlug } from "../content";
import { IS_LOCAL } from "../lib/site";
import { graph, organization, website, webPage, breadcrumbs, faqPage } from "../lib/schema";

export const getStaticPaths = (() =>
  PAGES.map((p) => ({ params: { slug: p.slug }, props: { page: p } }))) satisfies GetStaticPaths;

const { page } = Astro.props;
const path = `/${page.slug}`;

const crumbs = [
  { name: "الرئيسية", path: "/" },
  { name: page.clusterLabel, path: `/${page.cluster === "liver" ? "liver-transplant" : page.cluster === "kidney" ? "kidney-transplant" : "best-country-kidney-transplant"}` },
  { name: page.h1, path },
];

const nodes = [
  organization(),
  website(),
  webPage({ path, title: page.title, description: page.description }),
  breadcrumbs(crumbs),
];
if (page.faqs?.length) nodes.push(faqPage(page.faqs));
const jsonLd = graph(nodes);

const related = (page.related ?? []).map(bySlug).filter(Boolean);

const REVIEW_LABEL: Record<string, string> = {
  medical: "مراجعة طبية",
  legal: "مراجعة قانونية",
  commercial: "مراجعة تجارية",
};
---

<Layout title={page.title} description={page.description} path={path} jsonLd={jsonLd}>
  <article class="wrap pt-32 pb-8 sm:pt-36">
    <div class="mx-auto max-w-[52rem]">
      <Breadcrumbs items={crumbs} />

      <header>
        <p class="chip">{page.clusterLabel}</p>
        <h1 class="mt-5 font-display text-[2.125rem] font-extrabold leading-[1.3] tracking-tightest text-white sm:text-[2.75rem]">
          {page.h1}
        </h1>
        <p class="mt-6 text-[1.0625rem] leading-[1.95] text-ink-100 sm:text-lg">{page.lead}</p>
      </header>

      {/* شارة حالة المراجعة — تظهر في التطوير المحلي فقط، فلا يراها زائر أبداً */}
      {IS_LOCAL && page.review?.length && (
        <p class="mt-6 inline-flex flex-wrap items-center gap-2 rounded-2xl border border-amal/30 bg-amal/[.08] px-4 py-2 text-[0.8125rem] text-amal-light">
          <strong class="font-semibold">قبل النشر تحتاج:</strong>
          {page.review.map((r) => <span class="rounded-full bg-amal/15 px-2.5 py-0.5">{REVIEW_LABEL[r]}</span>)}
        </p>
      )}

      <div class="mt-8">
        <Disclaimer />
      </div>

      <div class="panel mt-8">
        <div class="prose-ar">
          {page.sections.map((s) => (
            <section>
              <h2>{s.h2}</h2>
              {s.body?.map((p) => <p set:html={p} />)}
              {s.list && (
                <ul>
                  {s.list.map((li) => <li set:html={li} />)}
                </ul>
              )}
              {s.table && (
                <div class="-mx-2 overflow-x-auto px-2">
                  <table>
                    <thead>
                      <tr>{s.table.head.map((h) => <th scope="col">{h}</th>)}</tr>
                    </thead>
                    <tbody>
                      {s.table.rows.map((row) => (
                        <tr>{row.map((cell) => <td set:html={cell} />)}</tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {s.priceTable === "liver" && (
                <PriceTable rows={LIVER_PRICES} caption="النطاقات المنشورة لتكلفة زرع الكبد في تركيا — منقولة عن مصادرها" />
              )}
              {s.priceTable === "kidney" && (
                <PriceTable rows={KIDNEY_PRICES} caption="النطاقات المنشورة لتكلفة زراعة الكلى في تركيا — منقولة عن مصادرها" />
              )}
              {(s.priceTable === "countryLiver" || s.priceTable === "countryKidney") && (
                <figure class="my-9">
                  <figcaption class="mb-4 text-[0.9375rem] font-semibold text-shifa-100">
                    {s.priceTable === "countryLiver"
                      ? "مقارنة تكلفة زرع الكبد بين الدول — كما نشرتها Safak Medical"
                      : "مقارنة تكلفة زراعة الكلى بين الدول — كما نشرتها Safak Medical"}
                  </figcaption>
                  <div class="-mx-2 overflow-x-auto px-2">
                    <table class="w-full border-collapse text-[0.9375rem]">
                      <thead>
                        <tr>
                          <th scope="col" class="border-b border-white/15 pb-3 text-right font-display font-semibold text-shifa-100">الدولة</th>
                          <th scope="col" class="border-b border-white/15 pb-3 text-right font-display font-semibold text-shifa-100">النطاق المنشور</th>
                        </tr>
                      </thead>
                      <tbody>
                        {(s.priceTable === "countryLiver" ? COUNTRY_LIVER : COUNTRY_KIDNEY).map((c) => (
                          <tr>
                            <td class="border-b border-white/[.07] py-3 align-top text-ink-200">{c.country}</td>
                            <td class="border-b border-white/[.07] py-3 align-top font-display font-bold text-white">{c.range}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <p class="mt-4 text-[0.8125rem] leading-relaxed text-ink-400">
                    {COUNTRY_SOURCE.note} رُصد: {COUNTRY_SOURCE.observed}.
                  </p>
                </figure>
              )}
              {s.note && (
                <p class="my-6 rounded-3xl border border-shifa-300/25 bg-shifa-400/[.07] p-5 text-[0.9375rem] leading-relaxed text-shifa-100">
                  <span set:html={s.note} />
                </p>
              )}
            </section>
          ))}
        </div>
      </div>

      {page.faqs?.length && (
        <section class="mt-14">
          <h2 class="font-display text-[1.625rem] font-bold text-white sm:text-[1.875rem]">أسئلة شائعة</h2>
          <div class="mt-7 space-y-3">
            {page.faqs.map((f) => (
              <details class="group rounded-3xl border border-white/10 bg-white/[.04] px-6 py-5 transition-colors open:border-shifa-300/30 open:bg-white/[.06]">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-display text-[1.0625rem] font-semibold text-white">
                  <span>{f.q}</span>
                  <svg viewBox="0 0 24 24" class="mt-1 h-4 w-4 shrink-0 text-shifa-300 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <p class="mt-4 text-[0.9375rem] leading-[1.95] text-ink-200" set:html={f.a} />
              </details>
            ))}
          </div>
        </section>
      )}

      {related.length > 0 && (
        <nav class="mt-14" aria-label="صفحات ذات صلة">
          <h2 class="font-display text-[1.375rem] font-bold text-white">اقرأ أيضاً</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {related.map((r) => (
              <a href={`/${r!.slug}`} class="card card-lift group !p-5">
                <div class="relative flex items-start justify-between gap-3">
                  <div>
                    <h3 class="font-display text-[1rem] font-bold text-white transition-colors group-hover:text-shifa-200">{r!.h1}</h3>
                    <p class="mt-1.5 text-[0.8125rem] leading-relaxed text-ink-300">{r!.keyword}</p>
                  </div>
                  <svg viewBox="0 0 24 24" class="mt-1 h-4 w-4 shrink-0 rotate-180 text-shifa-300 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </nav>
      )}

      <div class="mt-16">
        <Cta placement={`page:${page.slug}`} />
      </div>
    </div>
  </article>
</Layout>
